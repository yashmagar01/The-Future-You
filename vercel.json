{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "devCommand": "npm run dev",
  "installCommand": "rm -rf node_modules frontend/node_modules package-lock.json frontend/package-lock.json && npm install && npm install --prefix frontend --legacy-peer-deps",
  "framework": null,
  "rewrites": [
      {
        "source": "/favicon.ico",
        "destination": "/favicon.svg"
      },
      {
        "source": "/assets/(.*)",
        "destination": "/assets/$1"
      },
      {
        "source": "/wasm/(.*)",
        "destination": "/wasm/$1"
      },
      {
        "source": "/sw.js",
        "destination": "/sw.js"
      },
      {
        "source": "/robots.txt",
        "destination": "/robots.txt"
      },
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wasm/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
