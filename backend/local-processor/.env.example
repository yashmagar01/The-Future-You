# Copy to .env and fill in your own values. Never commit the real .env.

# --- Supabase (required) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PROJECT_ID=your-project-ref

# --- AI (optional) ---
# Without a key, /api/chat uses the local fallback response.
GEMINI_API_KEY=
HUGGING_FACE_API_KEY=
HUGGINGFACE_TOKEN=

# --- Server (optional, defaults shown) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
APP_BASE_URL=http://localhost:3001

# Comma-separated allowed origins. Empty = allow all (current behaviour).
CORS_ORIGINS=

# Relative paths resolve from backend/local-processor/; absolute paths are used as-is.
TMP_DIR=tmp
UPLOADS_DIR=uploads

# --- Background queue (keep disabled until multi-worker coordination exists) ---
ENABLE_QUEUE=false

# --- External processes (used only when ENABLE_QUEUE=true) ---
# Windows default is "python"; Linux/macOS/Termux default is "python3".
# PYTHON_BIN=python3
PYTHON_TIMEOUT_MS=900000
