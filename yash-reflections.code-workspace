{
  "folders": [
    {
      "name": "🎨 Frontend (React)",
      "path": "./frontend"
    },
    {
      "name": "⚙️ Backend (AI Processor)",
      "path": "./backend"
    },
    {
      "name": "🗄️ Supabase",
      "path": "./supabase-organized"
    },
    {
      "name": "📁 Root",
      "path": "."
    }
  ],
  "settings": {
    "typescript.tsdk": "frontend/node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.vite": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.vite": true,
      "**/bun.lockb": true,
      "**/package-lock.json": true
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  }
}
